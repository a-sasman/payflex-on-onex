---
import BranchingFinalChallenge from "../components/BranchingFinalChallenge.astro";
import KnowledgeCheck from "../components/KnowledgeCheck.astro";
import MissingStepReveal from "../components/MissingStepReveal.astro";
import ProductSort from "../components/ProductSort.astro";
import ReturnsJourney from "../components/ReturnsJourney.astro";
import SelectableRuleCards from "../components/SelectableRuleCards.astro";
import { courseData } from "../data/course";
import CourseLayout from "../layouts/CourseLayout.astro";
---

<CourseLayout title={courseData.meta.title} description={courseData.meta.description}>
  <div class="course-page">
    <header class="site-header" id="top">
      <nav class="course-nav container" aria-label="Course sections">
        <a class="brand-link" href="#welcome" aria-label="Payflex on oneX welcome">
          <img src="/assets/payflex/payflex-logo.png" alt="Payflex" width="2155" height="476" />
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="course-links">
          <span class="sr-only">Toggle course navigation</span><span></span><span></span><span></span>
        </button>
        <div class="course-links" id="course-links">
          {courseData.nav.map((item, index) => <a href={`#${item.id}`} class:list={[index === 0 && "active"]}>{item.label}</a>)}
        </div>
      </nav>
    </header>

    <main id="main-content">
      <div class="welcome-rules-stage">
        <div class="welcome-stage">
          <section class="welcome-section container" id="welcome" data-nav-section data-progress-section>
            <div class="welcome-panel">
              <div class="welcome-copy">
                <h1>{courseData.welcome.heading}</h1>
                <p>{courseData.welcome.copy}</p>
              </div>
              <section class="journey-copy" id="onex-journey" data-progress-section>
                <h2>{courseData.journey.heading}</h2>
                {courseData.journey.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                <p>
                  {courseData.journey.focus.lead} <strong>{courseData.journey.focus.tenderOrder}</strong>, the
                  <strong> {courseData.journey.focus.customerApproval}</strong> and the
                  <strong> {courseData.journey.focus.finalConfirmation}</strong>.
                </p>
              </section>
            </div>
          </section>
        </div>

        <section class="rules-section container" id="five-rules" data-nav-section data-progress-section>
          <p class="section-lead">{courseData.rules.intro}</p>
          <h2>{courseData.rules.heading}</h2>
          <SelectableRuleCards {...courseData.rules} />
        </section>
      </div>

      <section class="assessment-wrap container" id="kc-tender" data-progress-section>
        <KnowledgeCheck {...courseData.knowledgeChecks.tender} />
      </section>

      <section class="exclusions-section" id="exclusions" data-nav-section data-progress-section>
        <div class="decorative-pattern decorative-pattern--left" aria-hidden="true"></div>
        <div class="decorative-pattern decorative-pattern--right" aria-hidden="true"></div>
        <div class="container">
          <div class="policy-pill">
            <h2>{courseData.exclusions.heading}</h2>
            <p>{courseData.exclusions.copy}</p>
          </div>
          <ProductSort {...courseData.exclusions.sort} />
        </div>
      </section>

      <section class="assessment-wrap container" id="kc-exclusions" data-progress-section>
        <KnowledgeCheck {...courseData.knowledgeChecks.exclusions} />
      </section>

      <section class="returns-section container" id="returns" data-nav-section data-progress-section>
        <div class="policy-pill">
          <h2>{courseData.returns.heading}</h2>
          <p>{courseData.returns.copy}</p>
          <p>{courseData.returns.example}</p>
        </div>
        <ReturnsJourney {...courseData.returns.journey} />
      </section>

      <div class="refund-stage">
        <section class="assessment-wrap container" id="kc-refund" data-progress-section>
          <KnowledgeCheck {...courseData.knowledgeChecks.refund} />
        </section>
      </div>

      <div class="dark-stage">
        <section class="missing-section container" id="payflex-missing" data-nav-section data-progress-section>
          <h2>{courseData.missing.heading}</h2>
          {courseData.missing.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <MissingStepReveal {...courseData.missing.reveal} />
        </section>

        <section class="assessment-wrap assessment-wrap--dark container" id="kc-support" data-progress-section>
          <KnowledgeCheck {...courseData.knowledgeChecks.support} />
        </section>

        <section class="final-section container" id="final-challenge" data-nav-section data-progress-section>
          <h2>{courseData.finalChallenge.heading}</h2>
          <p class="final-scenario">{courseData.finalChallenge.scenario}</p>
          <p class="final-instruction"><strong>Make the right decisions:</strong> {courseData.finalChallenge.instruction.replace("Make the right decisions: ", "")}</p>
          <BranchingFinalChallenge {...courseData.finalChallenge} />
        </section>

        <section class="completion-section container" id="complete" data-progress-section>
          <h2>{courseData.completion.heading}</h2>
          <div class="completion-copy">
            <p class="completion-reminder"><strong>Remember:</strong> {courseData.completion.reminder.replace("Remember: ", "")}</p>
            <p>{courseData.completion.resources}</p>
          </div>
          <footer class="course-footer">
            <button class="return-button" type="button">{courseData.completion.returnLabel}</button>
            <p class="sr-only return-status" id="return-help" aria-live="polite"></p>
          </footer>
        </section>
      </div>
    </main>

    <a class="back-to-top" href="#top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 14 7-7 7 7M5 19l7-7 7 7" /></svg>
    </a>
  </div>

  <script>
    type SavedProgress = {
      version?: number;
      currentSection?: string;
      completed?: boolean;
      viewedSections?: string[];
      interactions?: Record<string, any>;
    };

    const storageKey = "payflex-on-onex-progress-v1";
    const scorm = (window as any).CourseSCORM;
    const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const links = document.querySelector<HTMLElement>(".course-links");
    const backToTop = document.querySelector<HTMLAnchorElement>(".back-to-top");
    const returnButton = document.querySelector<HTMLButtonElement>(".return-button");
    const returnStatus = document.querySelector<HTMLElement>(".return-status");
    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".course-links a"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-progress-section]"));
    const requiredSectionIds = sections.map((section) => section.id);
    const allowedSectionIds = new Set(requiredSectionIds);
    const sectionById = new Map(sections.map((section) => [section.id, section]));
    const requiredKnowledgeChecks = ["kc-tender-order", "kc-excluded-products", "kc-refund", "kc-support"];
    const suspendDataLimit = 4096;
    const scormReady = scorm?.initialize?.() ?? false;
    const lmsStatus = scormReady ? String(scorm?.getLessonStatus?.() || "").toLowerCase() : "";

    const validSectionId = (value: unknown): value is string => typeof value === "string" && sectionById.has(value);
    const validStringList = (value: unknown) => Array.isArray(value)
      ? [...new Set(value.filter((item): item is string => typeof item === "string" && allowedSectionIds.has(item)))]
      : [];
    const normalizeProgress = (value: unknown): SavedProgress => {
      const source = value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, any> : {};
      const currentSection = validSectionId(source.currentSection) ? source.currentSection : undefined;
      const interactions = source.interactions && typeof source.interactions === "object" && !Array.isArray(source.interactions) ? { ...source.interactions } : {};
      if (interactions["final-challenge-activity"]) interactions["final-challenge-activity"] = { complete: interactions["final-challenge-activity"].complete === true };
      return {
        version: 1,
        ...(currentSection ? { currentSection } : {}),
        completed: source.completed === true,
        viewedSections: validStringList(source.viewedSections),
        interactions,
      };
    };

    let savedProgress: SavedProgress = normalizeProgress({});
    if (scormReady) {
      try { savedProgress = normalizeProgress(JSON.parse(scorm?.getSuspendData?.() || "{}")); } catch {}
    } else {
      try { savedProgress = normalizeProgress(JSON.parse(localStorage.getItem(storageKey) || "{}")); } catch {}
    }
    const bookmarkedSection = scormReady ? String(scorm?.getLessonLocation?.() || "") : "";
    const resumeSection = savedProgress.currentSection || (validSectionId(bookmarkedSection) ? bookmarkedSection : undefined);
    if (resumeSection) {
      savedProgress.currentSection = resumeSection;
      savedProgress.viewedSections = [...new Set([...(savedProgress.viewedSections || []), resumeSection])];
    }
    if (lmsStatus === "completed" || lmsStatus === "passed") savedProgress.completed = true;

    let lastCommittedFingerprint = "";
    let lastSaveSucceeded: boolean | null = null;
    const serializedProgress = () => {
      savedProgress = normalizeProgress(savedProgress);
      const fullState = JSON.stringify(savedProgress);
      if (fullState.length <= suspendDataLimit) return fullState;
      return JSON.stringify({ version: 1, currentSection: savedProgress.currentSection, completed: savedProgress.completed });
    };
    const persistProgress = () => {
      const serialized = serializedProgress();
      const location = savedProgress.currentSection || "welcome";
      const fingerprint = `${location}\n${serialized}`;
      if (fingerprint === lastCommittedFingerprint && lastSaveSucceeded === true) return true;
      try { localStorage.setItem(storageKey, serialized); } catch {}
      lastSaveSucceeded = !scormReady || (scorm?.saveProgress?.(serialized, location) ?? false);
      if (lastSaveSucceeded) lastCommittedFingerprint = fingerprint;
      return lastSaveSucceeded;
    };

    const completionRequirementsMet = () => {
      if (savedProgress.completed) return true;
      const viewed = new Set(savedProgress.viewedSections || []);
      const interactions = savedProgress.interactions || {};
      return requiredSectionIds.every((id) => viewed.has(id))
        && requiredKnowledgeChecks.every((id) => interactions[id]?.submitted === true)
        && interactions["allowed-excluded-sort"]?.complete === true
        && interactions["final-challenge-activity"]?.complete === true;
    };
    const updateReturnState = () => {
      const ready = completionRequirementsMet();
      returnButton?.classList.toggle("is-ready", ready);
      returnButton?.setAttribute("aria-disabled", String(!ready));
      if (returnStatus && ready) returnStatus.textContent = "";
    };

    (window as any).CourseState = {
      getInteraction: (id: string) => savedProgress.interactions?.[id],
      setInteraction: (id: string, value: unknown) => {
        savedProgress.interactions = { ...(savedProgress.interactions || {}), [id]: value };
        persistProgress(); updateReturnState();
      },
    };
    window.dispatchEvent(new CustomEvent("course-state-ready"));

    const setBackToTopVisibility = () => backToTop?.classList.toggle("is-visible", window.scrollY > 500);
    window.addEventListener("scroll", setBackToTopVisibility, { passive: true }); setBackToTopVisibility();
    backToTop?.addEventListener("click", (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, left: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    });
    navToggle?.addEventListener("click", () => {
      const open = navToggle.getAttribute("aria-expanded") === "true";
      navToggle.setAttribute("aria-expanded", String(!open)); links?.classList.toggle("is-open", !open);
    });
    sectionLinks.forEach((link) => link.addEventListener("click", () => { navToggle?.setAttribute("aria-expanded", "false"); links?.classList.remove("is-open"); }));

    let restoredBookmarkGuard = resumeSection;
    const startProgressObservers = () => {
      const observer = new IntersectionObserver((entries) => {
        const intersecting = entries.filter((entry) => entry.isIntersecting); if (!intersecting.length) return;
        const viewed = new Set(savedProgress.viewedSections || []);
        intersecting.forEach((entry) => { const id = (entry.target as HTMLElement).id; if (validSectionId(id)) viewed.add(id); });
        const visible = intersecting.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const visibleId = (visible.target as HTMLElement).id;
        const nextSection = restoredBookmarkGuard || visibleId; if (!validSectionId(nextSection)) return;
        const previous = JSON.stringify(savedProgress);
        savedProgress.viewedSections = [...viewed]; savedProgress.currentSection = nextSection;
        const activeLink = sectionLinks.find((link) => link.getAttribute("href") === `#${nextSection}` || document.querySelector(link.getAttribute("href") || "")?.contains(sectionById.get(nextSection) || null));
        if (activeLink) sectionLinks.forEach((link) => link.classList.toggle("active", link === activeLink));
        if (JSON.stringify(savedProgress) !== previous) persistProgress();
        updateReturnState();
      }, { rootMargin: "-15% 0px -40%", threshold: [0, .05, .3] });
      sections.forEach((section) => observer.observe(section));
      if (restoredBookmarkGuard) window.setTimeout(() => { restoredBookmarkGuard = undefined; }, 250);
    };
    ["wheel", "touchstart", "pointerdown", "keydown"].forEach((eventName) => window.addEventListener(eventName, () => { restoredBookmarkGuard = undefined; }, { once: true, passive: true }));

    returnButton?.addEventListener("click", () => {
      if (!completionRequirementsMet()) {
        if (returnStatus) returnStatus.textContent = "Complete all sections, submit all four knowledge checks, finish the product sort and successfully complete the Final Challenge before returning.";
        return;
      }
      savedProgress.completed = true;
      persistProgress();
      const completed = !scormReady || (scorm?.setCompleted?.() ?? false);
      if (!completed) { if (returnStatus) { returnStatus.textContent = "Your completion could not be saved. Please try again before closing the course."; returnStatus.focus(); } return; }
      if (scormReady) scorm?.finish?.();
      if (returnStatus) returnStatus.textContent = "Completion saved. Returning to People Connect.";
      window.setTimeout(() => { if (window.opener) window.close(); }, 100);
    });

    const restoredElement = resumeSection ? sectionById.get(resumeSection) : undefined;
    if (restoredElement) {
      const restoreOnce = () => { restoredElement.scrollIntoView({ behavior: "auto", block: "start" }); requestAnimationFrame(() => requestAnimationFrame(startProgressObservers)); };
      if (document.readyState === "complete") restoreOnce(); else window.addEventListener("load", restoreOnce, { once: true });
    } else startProgressObservers();
    updateReturnState();
  </script>
</CourseLayout>
