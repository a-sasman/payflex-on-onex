---
interface RuleCard { id: string; title: string; copy: string; icon?: string; }
interface Props { id: string; legend: string; cards: RuleCard[]; }
const { legend, cards } = Astro.props as Props;
---

<div class="rule-card-list" role="list" aria-label={legend}>
  <div class="rule-card-grid">
    {cards.map((card) => (
      <article class="rule-card" role="listitem">
        {card.icon && <img src={card.icon} alt="" aria-hidden="true" />}
        <strong>{card.title}</strong><span>{card.copy}</span>
      </article>
    ))}
  </div>
</div>
